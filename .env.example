# Toggl Track API token, from Toggl profile settings (Profile > API Token)
TOGGL_API_TOKEN=

# Wave Full Access Token, generated in the Wave Business Portal developer section,
# scoped to a single business
WAVE_FULL_ACCESS_TOKEN=

# The Wave business ID this tool creates invoices against
WAVE_BUSINESS_ID=

# Optional. Only needed if Wave ever returns more than one active income
# account and you want auto-created products assigned to a specific one.
# Otherwise the app picks the first active income account automatically.
WAVE_INCOME_ACCOUNT_ID=

# Optional, defaults to 3000
PORT=3000
